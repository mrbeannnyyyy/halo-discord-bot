generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  ACCEPTED_FOR_INTERVIEW
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  PASSED
  FAILED
  REJECTED
  CANCELLED
}

enum InterviewStatus {
  SCHEDULED
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model User {
  id          String                @id @default(cuid())
  discordId   String                @unique
  username    String
  displayName String
  avatar      String?
  applications Application[]
  staffRoles  StaffRoleAssignment[]
  createdAt   DateTime              @default(now())
}

model Application {
  id            String              @id @default(cuid())
  applicantId   String
  applicant     User                @relation(fields: [applicantId], references: [id])
  status        ApplicationStatus   @default(PENDING)
  answers       ApplicationAnswer[]
  reviewerId    String?
  internalNotes String?
  interviews    Interview[]
  submittedAt   DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model ApplicationAnswer {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questionKey   String
  value         String
}

model Interview {
  id                String          @id @default(cuid())
  applicationId     String
  application       Application     @relation(fields: [applicationId], references: [id])
  applicantDiscordId String
  scheduledFor      DateTime
  timezone          String
  interviewerId     String?
  status            InterviewStatus @default(SCHEDULED)
  notes             String?
  dmStatus          String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model StaffRole {
  id            String                @id @default(cuid())
  discordRoleId String                @unique
  name          String
  permissions   StaffRolePermission[]
  assignments   StaffRoleAssignment[]
}

model StaffRolePermission {
  id         String    @id @default(cuid())
  roleId     String
  role       StaffRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission String

  @@unique([roleId, permission])
}

model StaffRoleAssignment {
  id     String    @id @default(cuid())
  roleId String
  role   StaffRole @relation(fields: [roleId], references: [id])
  userId String
  user   User      @relation(fields: [userId], references: [id])

  @@unique([roleId, userId])
}

model WebsiteContent {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ApplicationQuestion {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String?
  required    Boolean  @default(true)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id             String   @id @default(cuid())
  actorDiscordId String
  action         String
  target         String
  metadata       Json?
  createdAt      DateTime @default(now())
}
